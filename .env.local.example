# Copia este archivo a .env.local y rellena con los datos de tu proyecto Supabase
# (el mismo proyecto que ya usas para el diario de Erasmus).
# Settings -> API, dentro de tu proyecto en https://supabase.com/dashboard

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
